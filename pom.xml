<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>monggodb</groupId>
    <artifactId>monggodb-parent</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>MonggoDB</name>
    <description>mini Database Management System - Tugas Besar IF3140 Sistem Basis Data 2026</description>

    <modules>
        <module>contracts</module>
        <module>qp</module>
        <module>qo</module>
        <module>sm</module>
        <module>ccm</module>
        <module>frm</module>
        <module>app</module>
    </modules>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>monggodb</groupId>
                <artifactId>contracts</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>monggodb</groupId>
                <artifactId>qp</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>monggodb</groupId>
                <artifactId>qo</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>monggodb</groupId>
                <artifactId>sm</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>monggodb</groupId>
                <artifactId>ccm</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>monggodb</groupId>
                <artifactId>frm</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Javadoc: tag kustom @calls dan @calledBy dipakai di setiap metode interface antarkomponen. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.11.2</version>
                <configuration>
                    <encoding>UTF-8</encoding>
                    <docencoding>UTF-8</docencoding>
                    <charset>UTF-8</charset>
                    <failOnWarnings>false</failOnWarnings>
                    <tags>
                        <tag>
                            <name>calls</name>
                            <placement>a</placement>
                            <head>Memanggil:</head>
                        </tag>
                        <tag>
                            <name>calledBy</name>
                            <placement>a</placement>
                            <head>Dipanggil oleh:</head>
                        </tag>
                    </tags>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
